# Names only. Put values in `wrangler secret put` or a local .dev.vars that is not committed.
# CAL_LINK is the Cal.com path, for example abracadabra/working-session. Empty shows the in-chat time card.
CAL_LINK=
# Same link, if you already use the HQ agent name.
BOOKING_URL=
READINESS_CHECK_URL=https://check.abra-ca-dabra.app/check
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AI_GATEWAY_ID=abracadabra-chat
AI_GATEWAY_TOKEN=
CF_ACCOUNT_ID=
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Signs the abra.chat.handoff v1.0 body. The mail goes to houdini@, never to the visitor.
# HQ lead intake (same signed path as the /start/ form). Both empty = no HQ post.
HANDOFF_INTAKE_ORIGIN
PROJECT_INQUIRY_SIGNING_SECRET
HANDOFF_HMAC_SECRET=
CHAT_HANDOFF_TO=houdini@abra-ca-dabra.app
CHAT_HANDOFF_FROM=Abracadabra Chat <chat@abra-ca-dabra.app>
# Extra allowed Origins, comma-separated. The apex and localhost are already allowed.
CHAT_ORIGINS=
# Realtime voice. "true" shows the mic. Needs the AI binding (wrangler.jsonc), AI_GATEWAY_TOKEN and CF_ACCOUNT_ID.
VOICE_ENABLED=true
# Aura-2 speaker, for example luna, thalia, asteria, orion. Unknown names fall back to luna.
TTS_SPEAKER=luna
# Optional voice A/B test (luna, thalia, andromeda); empty = off.
TTS_SPEAKER_AB=
# Flux end-of-turn confidence, 0.5 to 0.9 (default 0.6).
VOICE_EOT_THRESHOLD=0.6
# Optional override.
TTS_MODEL=@cf/deepgram/aura-2-en
AI_RECAP_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
# Weekly stats export (wrangler secret put CHAT_STATS_TOKEN in production; 24+ chars)
CHAT_STATS_TOKEN=
# Phase 2 features ("false" turns one off). CHAT_AUDIT and RECEPTIONIST_DEMO are off unless "true".
CHAT_AUDIT=true
RECEPTIONIST_DEMO=true
CHAT_RECAP_CARD=true
CHAT_CLIPS=true
# Optional: where mini-audit report links point (default https://schema.abra-ca-dabra.app).
SCHEMA_ORIGIN=
