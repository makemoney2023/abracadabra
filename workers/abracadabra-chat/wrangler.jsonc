{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abracadabra-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "account_id": "6f6959ecba86d1de4d6cf6aa0b34528d",
  "workers_dev": true,
  // Workers AI binding: Flux speech-to-text needs a binding WebSocket. No API token is used for it.
  "ai": { "binding": "AI" },
  // Realtime voice. Set VOICE_ENABLED to "false" to turn the voice call off without a code change.
  "vars": {
    "VOICE_ENABLED": "true",
    "TTS_SPEAKER": "luna",
    // Voice A/B: a comma list of luna, thalia, andromeda gives each chat one of them (logged). Empty = TTS_SPEAKER only.
    "TTS_SPEAKER_AB": "",
    // Flux end-of-turn confidence (0.5 to 0.9). Lower = snappier turns, higher = fewer cut-offs.
    "VOICE_EOT_THRESHOLD": "0.6",
    // Phase 2 (docs/conversation-plan.md). Set any of these to "false" and redeploy to turn it off.
    // Mini-audit: a website named in the chat can be scanned with the Schema scanner (READINESS binding), after a tap.
    "CHAT_AUDIT": "true",
    // Receptionist demo: a two-minute voice role-play on the Voice agents page.
    "RECEPTIONIST_DEMO": "true",
    // "Here's what I heard" recap card at goodbye or on request, with a prefilled booking button.
    "CHAT_RECAP_CARD": "true",
    // Inline case-study film card (thumbnail, caption, links) when a reply cites one.
    "CHAT_CLIPS": "true"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_SESSION", "class_name": "ChatSessionDO" },
      // Anonymous weekly chat stats (one SQLite object). Read with GET /api/chat/stats + CHAT_STATS_TOKEN.
      { "name": "CHAT_STATS", "class_name": "ChatStatsDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatSessionDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatStatsDO"] }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  // The Readiness Check in the chat talks to the check worker directly (no public hop).
  "services": [
    { "binding": "READINESS", "service": "readiness-check" }
  ]
}
