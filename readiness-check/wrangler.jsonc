{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readiness-check",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "check.abra-ca-dabra.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "readiness-check"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handoff",
      "database_id": "b2be192c-db0d-447f-8d7c-b2c4d39df274"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LEAD_INTAKE",
        "queue": "lead-intake"
      },
      {
        "binding": "SCAN_JOBS",
        "queue": "scan-jobs"
      }
    ]
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://abra-ca-dabra.app",
    "NEXT_PUBLIC_CHECK_URL": "https://check.abra-ca-dabra.app"
  }
}
