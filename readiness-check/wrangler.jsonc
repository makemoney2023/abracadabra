{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readiness-check",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "check.abra-ca-dabra.app",
      "custom_domain": true
    },
    {
      "pattern": "schema.abra-ca-dabra.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "readiness-check"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handoff",
      "database_id": "b2be192c-db0d-447f-8d7c-b2c4d39df274"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LEAD_INTAKE",
        "queue": "lead-intake"
      },
      {
        "binding": "SCAN_JOBS",
        "queue": "scan-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "scan-jobs",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "scan-jobs-dlq"
      }
    ]
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://abra-ca-dabra.app",
    "NEXT_PUBLIC_CHECK_URL": "https://check.abra-ca-dabra.app",
    "NEXT_PUBLIC_SCHEMA_URL": "https://schema.abra-ca-dabra.app",
    // Fix-file offer (display only; Stripe charges STRIPE_PRICE_ID minus STRIPE_CREDIT_COUPON_ID).
    // Buying stays off until STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID and
    // STRIPE_CREDIT_COUPON_ID are set. Currency: USD (flagged for Christopher to confirm).
    "PRICE_DISPLAY": "$99.99",
    "PRICE_AMOUNT_CENTS": "9999",
    "PRICE_CURRENCY": "usd",
    "CREDIT_AMOUNT_CENTS": "1000",
    "DEEP_SCAN_ENABLED": "0"
  }
}
