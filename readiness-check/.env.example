NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Unused by the schema scan and by ops prospecting. Left for a manual Parallel call.
PARALLEL_API_KEY=
# Schema scan page search. AI Search only crawls domains on this Cloudflare account,
# so the scan fetches the site itself and uploads the homepage into built-in storage.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHECK_URL=
NEXT_PUBLIC_CAL_LINK=
CAL_WEBHOOK_SECRET=
# Handoff lead intake. Leave both empty to skip the POST. The person's result still saves.
# A finished website scan also posts the schema package to /api/intake/schema on this origin.
# Origin is the client Worker, with no path. Example: https://handoff.abracadabra-ai.workers.dev
HANDOFF_INTAKE_ORIGIN=
INTAKE_SIGNING_SECRET=
