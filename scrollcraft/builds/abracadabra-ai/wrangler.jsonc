{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abracadabra-marketing",
  "compatibility_date": "2026-10-06",
  "account_id": "6f6959ecba86d1de4d6cf6aa0b34528d",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "abra-ca-dabra.app",
      "custom_domain": true
    }
  ],
  "main": "worker/intake.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/assets/films/*", "/assets/video/*"]
  },
  "services": [
    { "binding": "CHAT", "service": "abracadabra-chat" }
  ]
}
