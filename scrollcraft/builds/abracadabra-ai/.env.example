# Worker secrets for the project intake form. Set them with wrangler secret put <NAME>.
# Do not commit real values.

# Required: HQ intake. The form posts a signed POST /api/intake/project-inquiry here.
HANDOFF_INTAKE_ORIGIN=https://handoff.abra-ca-dabra.app
PROJECT_INQUIRY_SIGNING_SECRET=

# Optional: also email a copy to houdini@ through Resend.
RESEND_API_KEY=
INTAKE_FROM=Abracadabra <intake@abra-ca-dabra.app>
INTAKE_TO=houdini@abra-ca-dabra.app
