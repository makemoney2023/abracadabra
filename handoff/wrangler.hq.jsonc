{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff-hq",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "account_id": "6f6959ecba86d1de4d6cf6aa0b34528d",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "handoff-hq"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "handoff"
    },
    {
      "binding": "BRANDING",
      "bucket_name": "handoff"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handoff",
      "database_id": "b2be192c-db0d-447f-8d7c-b2c4d39df274",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "LEAD_INTAKE",
        "queue": "lead-intake"
      }
    ]
  },
  "vars": {
    "HANDOFF_AI_GATEWAY_ID": "default",
    "HANDOFF_HQ_HOST": "handoff-hq.abracadabra-ai.workers.dev",
    "HANDOFF_HQ_ORIGIN": "https://handoff-hq.abracadabra-ai.workers.dev",
    "HANDOFF_APP_ORIGIN": "https://handoff.abracadabra-ai.workers.dev"
  }
}
