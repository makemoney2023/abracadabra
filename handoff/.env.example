# Public Supabase values. Neither is a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Production refuses to start when any of these three is empty.
SUPABASE_SECRET_KEY=
DATABASE_URL=
DIRECT_URL=
RESEND_API_KEY=

HANDOFF_FROM_EMAIL=
HANDOFF_BUCKET=handoff
HANDOFF_BRANDING_BUCKET=branding
HANDOFF_SUPER_ADMIN_EMAILS=
HANDOFF_REGION=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
HANDOFF_ALLOW_UNSCANNED=

# Cloudflare API token and R2 S3 credentials. Local only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
