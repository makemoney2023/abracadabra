# Product mail sender. Invite and file mail fail closed when this is empty.
# Workers handoff and handoff-hq already have this secret set to magic@abra-ca-dabra.app.
# The inbox shows Abra-ca-dabra Ai. This value stays the bare address.
# Leave this empty in git.
# Workers handoff and handoff-hq send through the EMAIL binding (Cloudflare Email Service).
# A process outside a Worker uses CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID.
# `assertProductionEnv` checks this address and is not called at Worker startup.
HANDOFF_FROM_EMAIL=
# Absolute client origin for share links and product mail.
# A workers.dev host or a staff host never becomes a share link.
# Public client host: https://handoff.abra-ca-dabra.app
HANDOFF_APP_ORIGIN=https://handoff.abra-ca-dabra.app
# Staff dashboard. Local dev: add `127.0.0.1 hq.localhost` and open http://hq.localhost:3000
HANDOFF_HQ_HOST=hq.abra-ca-dabra.app
# Public staff origin. The workers.dev staff host still answers, and redirects on that host stay there.
HANDOFF_HQ_ORIGIN=https://hq.abra-ca-dabra.app
# HMAC key for 5-minute file download links. Production download returns 503 when this is empty.
HANDOFF_SIGNING_SECRET=
# HMAC key for signed lead intake. An empty value rejects every POST to /api/intake.
# The Readiness Check uses the same value. A finished scan posts schema files to /api/intake/schema.
# Set the same value on the Readiness Check. Do not commit a real secret.
INTAKE_SIGNING_SECRET=
HANDOFF_BUCKET=handoff
HANDOFF_BRANDING_BUCKET=branding
# Local logo files when the BRANDING R2 binding is absent. Defaults to handoff/.data/branding.
HANDOFF_BRANDING_PATH=
# Local file bytes when the R2 file bucket is absent. Defaults to handoff/.data/objects.
HANDOFF_OBJECT_PATH=
HANDOFF_SUPER_ADMIN_EMAILS=
# Admin sign-in. Username is admin. Leave this empty in git. At least 5 characters.
HANDOFF_ADMIN_PASSWORD=
HANDOFF_REGION=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
HANDOFF_ALLOW_UNSCANNED=
# Scan container only. Worker handoff-scan sets these. Do not set them for the Next app.
# HANDOFF_D1_ORIGIN=http://handoff.d1
# HANDOFF_R2_ORIGIN=http://handoff.r2

# Cloudflare API token and R2 S3 credentials. Local only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Cloudflare AI Gateway id. The Worker uses the AI binding. A local run without it uses the account id and API token.
HANDOFF_AI_GATEWAY_ID=default
# Signs the POST that wakes the HQ agent. Set the same secret on handoff and handoff-agent. Leave empty in git.
AGENT_WAKE_SECRET=
# Where handoff posts wakes, and where staff chat opens its socket. Set the same value on handoff and handoff-hq. The hostname must be the handoff-agent worker.
AGENT_URL=https://agent.abra-ca-dabra.app
# Signs the staff chat socket token. Set the same value on handoff-hq and handoff-agent. Leave empty in git.
HQ_CHAT_SECRET=
# Bearer the agent uses when it writes a client email or Slack note through HQ. Set on both workers. Leave empty in git.
CLIENT_CHANNEL_SECRET=
# Slack app in the agency workspace. Events URL is https://agent.abra-ca-dabra.app/channels/slack. Leave empty in git.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_USER_ID=
# Comma-separated Slack user ids that the agent treats as staff and does not answer.
SLACK_STAFF_USER_IDS=
# Starts cloud runs from the staff dashboard. Not a secret on the agent Worker.
CURSOR_API_KEY=
# Access service token the agent sends to the MCP portal. Not used by this Worker.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# MCP portal URL for worker handoff-agent. Leave empty until the Cloudflare One portal exists.
MCP_PORTAL_URL=
# AGENT_MCP_TOKEN is the deployment knowledge key stored on the MCP portal for the Handoff upstream. It is not a Worker secret and is not set in this file.
# GitHub App. Leave these empty in git. Set them on both workers.
# The private key is the PEM. A literal \n in the value is turned into a real line break.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
