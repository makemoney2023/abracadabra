# Server-only. Production refuses to start when this is empty.
# Locker records use the D1 binding `DB` in wrangler.jsonc, not an environment URL.
RESEND_API_KEY=

HANDOFF_FROM_EMAIL=
# Absolute origin the scan worker puts in product email. Example: https://handoff.example.workers.dev
HANDOFF_APP_ORIGIN=
HANDOFF_BUCKET=handoff
HANDOFF_BRANDING_BUCKET=branding
# Local logo files when the BRANDING R2 binding is absent. Defaults to handoff/.data/branding.
HANDOFF_BRANDING_PATH=
# Local file bytes when the R2 file bucket is absent. Defaults to handoff/.data/objects.
HANDOFF_OBJECT_PATH=
HANDOFF_SUPER_ADMIN_EMAILS=
HANDOFF_REGION=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
HANDOFF_ALLOW_UNSCANNED=

# Cloudflare API token and R2 S3 credentials. Local only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
