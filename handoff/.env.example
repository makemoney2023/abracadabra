# Server-only. Invite magic links fail closed when this is empty.
# The home page opens the studio locker without sending mail.
# `assertProductionEnv` checks this key and is not called at Worker startup.
# Locker records use the D1 binding `DB` in wrangler.jsonc, not an environment URL.
RESEND_API_KEY=

HANDOFF_FROM_EMAIL=
# Absolute origin the scan worker puts in product email. Deployed: https://handoff.abracadabra-ai.workers.dev
# Staff pages use this origin for links into a client space (/w/[slug]).
HANDOFF_APP_ORIGIN=
# Staff dashboard. Local dev: add `127.0.0.1 hq.localhost` and open http://hq.localhost:3000
HANDOFF_HQ_HOST=hq.abra-ca-dabra.app
# Until abra-ca-dabra.app is a zone on this account, the client Worker sets this to
# https://handoff-hq.abracadabra-ai.workers.dev. Switch it back to the line below when the zone moves.
HANDOFF_HQ_ORIGIN=https://hq.abra-ca-dabra.app
# HMAC key for 5-minute file download links. Production download returns 503 when this is empty.
HANDOFF_SIGNING_SECRET=
HANDOFF_BUCKET=handoff
HANDOFF_BRANDING_BUCKET=branding
# Local logo files when the BRANDING R2 binding is absent. Defaults to handoff/.data/branding.
HANDOFF_BRANDING_PATH=
# Local file bytes when the R2 file bucket is absent. Defaults to handoff/.data/objects.
HANDOFF_OBJECT_PATH=
HANDOFF_SUPER_ADMIN_EMAILS=
# Admin sign-in. Username is admin. Leave this empty in git. At least 5 characters.
HANDOFF_ADMIN_PASSWORD=
HANDOFF_REGION=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
HANDOFF_ALLOW_UNSCANNED=

# Cloudflare API token and R2 S3 credentials. Local only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
# Cloudflare AI Gateway id. The Worker uses the AI binding. A local run without it uses the account id and API token.
HANDOFF_AI_GATEWAY_ID=default
