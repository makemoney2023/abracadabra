{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff-agent",
  "main": "src/agent/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ClientAgent", "class_name": "ClientAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClientAgent"] }],
  "r2_buckets": [{ "binding": "SKILLS", "bucket_name": "handoff-skills" }],
  "ai": { "binding": "AI" },
  "vars": {
    "MCP_PORTAL_URL": "",
    "AGENT_WAKE_SECRET": "",
    "CF_ACCESS_CLIENT_ID": "",
    "CF_ACCESS_CLIENT_SECRET": ""
  },
  "env": {
    "test": {
      "durable_objects": {
        "bindings": [{ "name": "ClientAgent", "class_name": "ClientAgent" }]
      },
      "r2_buckets": [{ "binding": "SKILLS", "bucket_name": "handoff-skills" }],
      "vars": {
        "MCP_PORTAL_URL": "https://portal.example.invalid/mcp",
        "AGENT_WAKE_SECRET": "test-wake-secret",
        "CF_ACCESS_CLIENT_ID": "test-access-id",
        "CF_ACCESS_CLIENT_SECRET": "test-access-secret"
      }
    }
  }
}
