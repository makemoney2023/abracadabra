{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "handoff.abra-ca-dabra.app",
      "custom_domain": true
    }
  ],
  "account_id": "6f6959ecba86d1de4d6cf6aa0b34528d",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "handoff"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "handoff"
    },
    {
      "binding": "BRANDING",
      "bucket_name": "handoff"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handoff",
      "database_id": "b2be192c-db0d-447f-8d7c-b2c4d39df274",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "LEAD_INTAKE",
        "queue": "lead-intake"
      },
      {
        "binding": "GITHUB_EVENTS",
        "queue": "github-events"
      }
    ],
    "consumers": [
      {
        "queue": "lead-intake",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "lead-intake-dlq"
      },
      {
        "queue": "github-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "github-events-dlq"
      }
    ]
  },
  "vars": {
    "HANDOFF_AI_GATEWAY_ID": "default",
    "HANDOFF_HQ_HOST": "hq.abra-ca-dabra.app",
    "HANDOFF_HQ_ORIGIN": "https://hq.abra-ca-dabra.app"
  }
}
